# ZhirTerminalAssist AI Configuration Example
# Copy this file to .env or configure directly via the GUI Settings / CLI

# AI Provider options: openrouter, openai, local
AI_PROVIDER=openrouter

# API Key (leave empty for local models like Ollama)
AI_API_KEY=

# Base URL (default for OpenRouter is https://openrouter.ai/api/v1, Ollama: http://localhost:11434/v1)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (e.g. google/gemini-2.5-flash, meta-llama/llama-3.3-70b-instruct, mistralai/mistral-large, qwen2.5:7b)
AI_MODEL=google/gemini-2.5-flash

# Generation parameters
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Security options
# Set to true only if you want safe read-only commands (e.g. uname, lspci) to execute without confirmation
AUTO_EXECUTE_SAFE_COMMANDS=false
